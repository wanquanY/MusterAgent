      "operation_sha256": "dffc599260ca95bcb16ae0caffb5fb539f35cfdf13179fc935358bc858f3d9e5",
      "title": "Propose memory content and applicability for review",
      "description": "Create an unpublished memory candidate from factual content and ordered human-readable applicability conditions. Choose scope=agent_profile only for this exact current Agent, or scope=user for the current account; Runtime binds the selected scope to the trusted caller. Runtime derives a neutral future-use description from kind. Do not send outcome, status, published, approved, Agent IDs or account IDs: none are input fields. This tool does not publish memory, grant consent or prove success. Original evaluation, inspection and exact experience.publish approval remain required.",
      "effect": "write_reversible",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "claim": {
            "description": "The complete factual statement or preference proposed for memory, in the user's language. Include any substantive lesson or observed result here. This is content to review, not a claim that storage or approval has completed.",
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "conditions": {
            "description": "Ordered applicability conditions in complete user-readable text. Use an empty list when unconditional. Include all meaningful restrictions, but no arbitrary machine field names, nested objects, authority IDs or operation status.",
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "kind": {
            "enum": [
              "semantic",
              "procedure",
              "failure",
              "preference",
              "policy_proposal"
            ],
            "type": "string"
          },
          "scope": {
            "enum": [
              "user",
              "agent_profile"
            ],
            "type": "string"
          },
          "sensitivity": {
            "enum": [
              "private",
              "internal"
            ],
            "type": "string"
          },
          "supersedes_candidate_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "scope",
          "kind",
          "claim",
          "conditions",
          "confidence",
          "sensitivity"
        ],
        "type": "object"
      },
      "scope_alternatives": [
        []
      ],
