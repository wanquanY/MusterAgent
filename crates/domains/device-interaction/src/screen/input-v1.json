  "$defs": {
    "on_screen_only": {
      "type": "boolean"
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "max_depth": {
      "minimum": 1,
      "type": "integer",
      "maximum": 64
    },
    "max_elements": {
      "minimum": 1,
      "type": "integer",
      "maximum": 10000
    },
    "query": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*$"
    },
    "button": {
      "enum": [
        "left",
        "right",
        "middle"
      ],
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[^\\u0000]*$",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "delivery_mode": {
      "enum": [
        "background",
        "foreground"
      ],
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[^\\u0000]*$",
      "minLength": 1
    },
    "element_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "modifier": {
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\u0000]*$"
      },
      "minItems": 1,
      "type": "array",
      "maxItems": 8
    },
    "scope": {
      "enum": [
        "window",
        "desktop"
      ],
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[^\\u0000]*$",
      "minLength": 1
    },
    "x": {
      "type": "number",
      "minimum": -100000,
      "maximum": 100000
    },
    "duration_ms": {
      "maximum": 10000,
      "minimum": 0,
      "type": "integer"
    },
    "steps": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "amount": {
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "by": {
      "enum": [
        "line",
        "page"
      ],
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[^\\u0000]*$",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[^\\u0000]*$",
      "minLength": 1
    },
    "delay_ms": {
      "maximum": 5000,
      "minimum": 0,
      "type": "integer"
    },
    "text": {
      "type": "string",
      "maxLength": 16384,
      "pattern": "^[^\\u0000]*$"
    },
    "bounded_identifier_text": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[^\\u0000]*$",
      "minLength": 1
    },
    "ax_action": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[^\\u0000]*$",
      "minLength": 1,
      "enum": [
        "press",
        "show_menu",
        "pick",
        "confirm",
        "cancel",
        "open"
      ]
    }
  }
}
